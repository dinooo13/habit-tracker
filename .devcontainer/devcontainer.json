{
  "name": "habit-tracker",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli": {}
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Habit Tracker (nuxt dev)",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash scripts/setup-agent-env.sh"
}
